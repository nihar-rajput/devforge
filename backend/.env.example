# =============================================================================
# DevForge Configuration
# Copy this file to .env and modify values as needed.
# =============================================================================

# --- Application ---
DEVFORGE_APP_NAME=DevForge
DEVFORGE_APP_VERSION=0.1.0
DEVFORGE_DEBUG=false
DEVFORGE_LOG_LEVEL=INFO

# --- Server ---
DEVFORGE_HOST=127.0.0.1
DEVFORGE_PORT=8000

# --- Database ---
DEVFORGE_DATABASE_URL=sqlite+aiosqlite:///./devforge.db

# --- Paths ---
DEVFORGE_CACHE_DIR=./cache
DEVFORGE_DOWNLOAD_DIR=./downloads
DEVFORGE_LOG_DIR=./logs
DEVFORGE_PLUGIN_DIR=./src/plugins

# --- Download Manager ---
DEVFORGE_MAX_CONCURRENT_DOWNLOADS=3
DEVFORGE_DOWNLOAD_SEGMENT_COUNT=4
DEVFORGE_DOWNLOAD_SEGMENT_THRESHOLD_MB=50
DEVFORGE_DOWNLOAD_TIMEOUT_SECONDS=300
DEVFORGE_DOWNLOAD_RETRY_MAX=3
DEVFORGE_DOWNLOAD_RETRY_BASE_DELAY=1.0

# --- Installation Engine ---
DEVFORGE_INSTALL_TIMEOUT_SECONDS=600
DEVFORGE_MAX_CONCURRENT_INSTALLS=1

# --- Detection ---
DEVFORGE_DETECTION_TIMEOUT_SECONDS=10

# --- Updates ---
DEVFORGE_UPDATE_CHECK_INTERVAL_HOURS=24
